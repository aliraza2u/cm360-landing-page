# Copy to `.env` or `.env.local` and fill in real values.
# Restart `next dev` after changes.
# On Vercel: Project → Settings → Environment Variables (same keys).

# Used for Contact, Privacy/Terms, and /delete-account mailto CTAs
NEXT_PUBLIC_CONTACT_EMAIL=support@cm360.site
# Pakistan local (03XXXXXXXXX) or E.164 digits without + (923XXXXXXXXX)
NEXT_PUBLIC_CONTACT_WHATSAPP=03000000000

NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_OFFICE=
NEXT_PUBLIC_CONTACT_HOURS=

NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=

# Official Android APK upstream URL (server-only — never NEXT_PUBLIC_*).
# Public users always download via https://cm360.site/download/android
# Update this in Vercel → Environment Variables when you publish a new EAS build,
# then re-run: pnpm android:inspect -- /path/to/new.apk (commit updated android-release.json)
ANDROID_APK_URL=https://expo.dev/artifacts/eas/YOUR_ARTIFACT_ID.apk
# Optional local fallback (usually leave unset in production when using ANDROID_APK_URL):
# ANDROID_APK_PATH=public/downloads/cm360-android.apk
