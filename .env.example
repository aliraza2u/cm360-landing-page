# Copy to `.env` or `.env.local` and fill in real values.
# Restart `next dev` after changes.
# On Vercel: Project → Settings → Environment Variables (same keys).

# Used for Contact, Privacy/Terms, and /delete-account mailto CTAs
NEXT_PUBLIC_CONTACT_EMAIL=support@cm360.site
# Pakistan local (03XXXXXXXXX) or E.164 digits without + (923XXXXXXXXX)
NEXT_PUBLIC_CONTACT_WHATSAPP=03000000000

NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_OFFICE=
NEXT_PUBLIC_CONTACT_HOURS=

NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
